---
const title = "🏠 Mi Casa de Muñecas GIF";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #111;
        color: white;
        text-align: center;
      }
      #dollhouse {
        position: relative;
        width: 1000px;
        height: 600px;
        margin: 30px auto;
        border: 8px solid #333;
        border-radius: 15px;
        overflow: hidden;
        background: url("https://picsum.photos/id/1015/1000/600") center/cover;
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
      }
      .draggable {
        position: absolute;
        cursor: grab;
        user-select: none;
        transition: box-shadow 0.2s;
        max-width: 180px;
      }
      .draggable:active {
        cursor: grabbing;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
      }
      #controls {
        margin: 20px;
      }
      button,
      input {
        padding: 10px 15px;
        margin: 5px;
        font-size: 16px;
      }
    </style>
  </head>
  <body>
    <h1>🏠 Arrastra tus GIFs por la casa</h1>

    <div id="controls">
      <input type="file" id="upload" accept="image/gif,image/*" multiple />
      <button id="add-random">🎲 Añadir GIF random de ejemplo</button>
    </div>

    <div id="dollhouse"></div>

    <!-- 🔥 ESTE ES EL TRUCO: is:inline -->
    <script is:inline>
      let zCounter = 10;

      function makeDraggable(el) {
        let pos1 = 0,
          pos2 = 0,
          pos3 = 0,
          pos4 = 0;

        el.onmousedown = dragMouseDown;

        function dragMouseDown(e) {
          e.preventDefault();
          el.style.zIndex = ++zCounter;

          pos3 = e.clientX;
          pos4 = e.clientY;

          document.onmouseup = closeDragElement;
          document.onmousemove = elementDrag;
        }

        function elementDrag(e) {
          e.preventDefault();
          pos1 = pos3 - e.clientX;
          pos2 = pos4 - e.clientY;
          pos3 = e.clientX;
          pos4 = e.clientY;

          el.style.top = el.offsetTop - pos2 + "px";
          el.style.left = el.offsetLeft - pos1 + "px";
        }

        function closeDragElement() {
          document.onmouseup = null;
          document.onmousemove = null;
        }
      }

      function addRandomGif() {
        const gifs = [
          "https://i.gifer.com/7Z9v.gif",
          "https://i.gifer.com/8KzV.gif",
          "https://i.gifer.com/5Z7R.gif",
          "https://i.gifer.com/3QjX.gif",
        ];
        const randomGif = gifs[Math.floor(Math.random() * gifs.length)];

        const img = document.createElement("img");
        img.src = randomGif;
        img.className = "draggable";
        img.style.width = "180px";
        img.style.left = Math.random() * 700 + "px";
        img.style.top = Math.random() * 400 + "px";

        document.getElementById("dollhouse").appendChild(img);
        makeDraggable(img);
      }

      // Subir archivos
      document
        .getElementById("upload")
        .addEventListener("change", function (e) {
          const container = document.getElementById("dollhouse");
          for (let file of e.target.files) {
            if (file.type.startsWith("image/")) {
              const img = document.createElement("img");
              img.src = URL.createObjectURL(file);
              img.className = "draggable";
              img.style.width = "180px";
              img.style.left = Math.random() * 700 + "px";
              img.style.top = Math.random() * 400 + "px";

              container.appendChild(img);
              makeDraggable(img);
            }
          }
        });

      // Botón random
      document
        .getElementById("add-random")
        .addEventListener("click", addRandomGif);

      // Al cargar la página
      window.addEventListener("load", () => {
        addRandomGif();
        addRandomGif();
      });
    </script>
  </body>
</html>
